# Vercel → Project → Settings → Environment Variables

# ── Firebase (захиалгын бүртгэл) ──────────────────────────────────

# Firebase Realtime Database secret. Энэ бол ADMIN эрх — VITE_ угтвартай
# нэрээр ХЭЗЭЭ Ч бүү тавь, эс тэгвээс browser bundle-д шууд орно.
# Firebase console → Project settings → Service accounts → Database secrets
RTDB_AUTH=

# Заавал биш. Өгөөгүй бол native app-тай ижил зангилаа руу бичнэ.
RTDB_URL=https://printmn-c0d28-default-rtdb.firebaseio.com/pmn

# ── Объект сан (хэрэглэгчийн зураг) ───────────────────────────────
# ХООСОН ОРХИЖ БОЛНО. Тохируулаагүй үед вэб хэвийн ажиллаж, захиалга авна —
# зөвхөн зураг хүлээн авахгүй бөгөөд хэрэглэгчид «ажилтан залгаж авна» гэж
# харуулна. Дараа нь эдгээрийг бөглөөд redeploy хийхэд автоматаар асна.
#
# Cloudflare dashboard → R2 → Manage API tokens → Create API token
# Эрх: Object Read & Write, зөвхөн энэ bucket дээр.
# ⚠️ R2_SECRET_ACCESS_KEY бол бүрэн эрх — VITE_ угтвар БҮҮ хэрэглэ.

R2_ACCOUNT_ID=
R2_BUCKET=printmn-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Заавал биш. Өгвөл R2-ийн оронд ДУРЫН S3-нийцтэй сан руу очно —
# дэлгүүрийн NAS дээрх MinIO, Backblaze B2, AWS S3 гэх мэт.
# Жишээ: https://s3.printmn.mn:9000  (интернэтэд заавал https)
# S3_ENDPOINT=
# S3_REGION=us-east-1

# ── Төлбөр ────────────────────────────────────────────────────────
# Зураг нь төлбөр баталгаажтал ажилтанд ХАРАГДАХГҮЙ.

# 1) Дансаар шилжүүлэх — гараар баталгаажуулна. Хамгийн энгийн зам.
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# 2) QPay — QR + банкны апп, автоматаар баталгаажна (заавал биш).
# Гурвуулаа бөглөгдсөн үед л идэвхжинэ. QPay-ээс merchant гэрээгээр авна.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Туршихад: https://merchant-sandbox.qpay.mn
QPAY_BASE_URL=https://merchant.qpay.mn

# ── Ажилтны хуудас (/admin) ───────────────────────────────────────
# Урт, санамсаргүй мөр. Жишээ: openssl rand -base64 32
ADMIN_TOKEN=

# ── Telegram (заавал биш) ─────────────────────────────────────────
# Шинэ захиалгын мэдэгдэл. Хоосон бол мэдэгдэл явахгүй.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
